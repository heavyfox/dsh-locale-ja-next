{
  "name": "dsh-locale-ja-next",
  "version": "0.2.0",
  "description": "Offline Japanese language pack for DeepSeek Harness 0.2.x Web UI",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/heavyfox/dsh-locale-ja-next.git" },
  "homepage": "https://github.com/heavyfox/dsh-locale-ja-next#readme",
  "bugs": { "url": "https://github.com/heavyfox/dsh-locale-ja-next/issues" },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client.d.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["lib", "locale", "cordis.patch.yml", "README.md", "REPORT.ja.md", "REPORT-0.2.x.ja.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "engines": { "node": "^22.19.0 || >=24.0.0", "dsh": ">=0.2.0-rc.2 <0.3.0-0" },
  "publishConfig": { "access": "public" },
  "keywords": ["dsh-plugin", "deepseek-harness", "japanese", "locale"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-locale"] }
  },
  "peerDependencies": { "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-client-locale": { "optional": true } },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/cordis": "4.0.5",
    "dsh-locale-020": "npm:@deepseek-ai/dsh-client-locale@0.2.0-rc.2",
    "@types/node": "24.13.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "@playwright/test": "1.63.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:legacy": "node scripts/test-legacy.mjs",
    "check-translations": "node scripts/check-translations.mjs",
    "extract-locales": "node scripts/extract-locales.mjs",
    "check-compatibility": "node scripts/check-compatibility.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "prepack": "node scripts/build.mjs"
  }
}
